{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Synthesis Engine",
  "version": "0.1.0",
  "identifier": "com.synthesis.engine",
  "build": {
    "beforeDevCommand": "cd .. && npm run dev",
    "beforeBuildCommand": "cd .. && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Synthesis Engine",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' https://*.supabase.co https://api.openai.com https://api.anthropic.com https://generativelanguage.googleapis.com https://geocoding-api.open-meteo.com https://api.open-meteo.com"
      },
      "capabilities": [
        {
          "identifier": "default",
          "description": "Default capabilities for the app",
          "local": true,
          "windows": ["main"],
          "permissions": [
            "core:default",
            "fs:default",
            "fs:read-app-meta",
            "fs:write-app-meta",
            "shell:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {
      "scope": ["$APP/*", "$APP/journal/*"]
    }
  }
}
