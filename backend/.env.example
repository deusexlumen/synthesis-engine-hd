# Database
DATABASE_URL="postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres"

# Supabase
SUPABASE_URL="https://[project].supabase.co"
SUPABASE_ANON_KEY="[anon-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# OpenAI
OPENAI_API_KEY="sk-..."

# JWT
JWT_SECRET="your-jwt-secret-min-32-characters"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-characters"

# Server
PORT=3000
NODE_ENV="development"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Swiss Ephemeris
SE_EPHE_PATH="./ephemeris"
# Professional ephemeris tier (Swiss Ephemeris) for PREMIUM/PRO users.
# Off by default: without "true" every tier uses the standard provider.
EPHEMERIS_PRO_ENABLED=false

# Email (Resend — https://resend.com)
# Without RESEND_API_KEY emails are only logged to the console (dev fallback)
RESEND_API_KEY="re_..."
EMAIL_FROM="Synthesis Engine <noreply@example.com>"

# Frontend URL used to build reset/verify links in emails
FRONTEND_URL="http://localhost:5173"
