# Database
# DATABASE_URL is used for runtime queries, DIRECT_URL for Prisma migrations
# (schema.prisma -> datasource.directUrl). Locally both can be the same string.
#
# Hosted on Supabase, they must differ. `prisma migrate deploy` needs advisory
# locks and prepared statements, which the transaction pooler (6543) does not
# support, so DIRECT_URL has to be a session-mode connection. Both pooler
# hosts are IPv4-reachable; db.<ref>.supabase.co is not, which is why the
# direct host is unusable from IPv4-only platforms such as Render.
#   DATABASE_URL  ...pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   DIRECT_URL    ...pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres"

# Supabase
SUPABASE_URL="https://[project].supabase.co"
SUPABASE_ANON_KEY="[anon-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# OpenAI
OPENAI_API_KEY="sk-..."

# JWT
JWT_SECRET="your-jwt-secret-min-32-characters"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-characters"

# Server
PORT=3000
NODE_ENV="development"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Swiss Ephemeris
SE_EPHE_PATH="./ephemeris"
# Professional ephemeris tier (Swiss Ephemeris) for PREMIUM/PRO users.
# Off by default: without "true" every tier uses the standard provider.
EPHEMERIS_PRO_ENABLED=false

# Email (Resend — https://resend.com)
# Without RESEND_API_KEY emails are only logged to the console (dev fallback)
RESEND_API_KEY="re_..."
EMAIL_FROM="Synthesis Engine <noreply@example.com>"

# Frontend URL used to build reset/verify links in emails
FRONTEND_URL="http://localhost:5173"

# Comma-separated CORS allowlist (browser origins permitted to call the API).
# Unset in production the code falls back to https://synthesis-engine.com, so
# any other deployed frontend is blocked by CORS.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
